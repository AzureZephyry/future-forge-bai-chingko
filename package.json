    "test:legacy": "playwright test -c playwright.legacy.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "motion": "^14.5.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "8.5.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
